{
    "name": "ran/coding-standards",
    "description": "Shared PHP and WordPress coding standards for Rockets Are Nostalgic projects.",
    "type": "phpcodesniffer-standard",
    "license": "MIT",
    "homepage": "https://github.com/RocketsAreNostalgic/ran-coding-standards",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=7.4",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
        "phpcompatibility/php-compatibility": "10.0.0-alpha2",
        "phpcompatibility/phpcompatibility-paragonie": "2.0.0-alpha2",
        "phpcompatibility/phpcompatibility-wp": "3.0.0-alpha2",
        "squizlabs/php_codesniffer": "^3.13.6",
        "wp-coding-standards/wpcs": "^3.4.1"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true,
        "platform": {
            "php": "7.4.0"
        }
    },
    "scripts": {
        "validate:strict": "composer validate --strict --no-check-publish --no-check-all",
        "test": "@php tests/run.php",
        "check": [
            "@validate:strict",
            "@test"
        ]
    }
}
