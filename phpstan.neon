parameters:
    level: 8
    phpVersion: 70400
    treatPhpDocTypesAsCertain: false
    paths:
        - .
    excludePaths:
        analyseAndScan:
            - vendor
    tmpDir: vendor/.phpstan-cache
    bootstrapFiles:
        - vendor/squizlabs/php_codesniffer/autoload.php
    scanDirectories:
        - vendor/phpcsstandards/phpcsutils
