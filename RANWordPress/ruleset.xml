<?xml version="1.0"?>
<ruleset name="RANWordPress">
    <description>Shared WordPress PHP baseline for RAN projects.</description>

    <rule ref="RAN"/>

    <!-- Consumers must set testVersion to their declared supported PHP range. -->
    <rule ref="PHPCompatibilityWP"/>

    <rule ref="WordPress-Extra">
        <!-- RAN PHP uses PSR-4 class filenames; identity/prefix policy remains repository-local. -->
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
        <!-- Throwable payloads are diagnostic data; escape them at the actual rendering boundary. -->
        <exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>
    </rule>
    <!-- Formatting failures must remain blocking when consumers hide warnings with -n. -->
    <rule ref="Generic.Formatting.MultipleStatementAlignment">
        <properties>
            <property name="error" value="true"/>
        </properties>
    </rule>
    <rule ref="WordPress.Arrays.MultipleStatementAlignment">
        <type>error</type>
    </rule>
</ruleset>
